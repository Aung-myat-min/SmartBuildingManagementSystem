        <mxCell id="sess_r3" value="&lt;b&gt;rank 3 — Office Staff&lt;/b&gt;&lt;hr size=&#x27;1&#x27;&gt;Dashboard · Equipment · Sensors&lt;br&gt;Maintenance Requests · Historical Records&lt;br&gt;&lt;br&gt;&lt;i&gt;isBuildingLocked: scoped to one building.&lt;br&gt;The filter is disabled, not hidden.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#d8dbe1;fontSize=12" vertex="1" parent="1">
