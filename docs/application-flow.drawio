  <diagram id="req" name="2 · Maintenance request lifecycle">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="req_t2" value="Maintenance request lifecycle" style="text;html=1;align=left;verticalAlign=top;fontSize=17;fontStyle=1;fontColor=#1f2430" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="req_t2s" value="UML state machine. Transitions are REQUEST_NEXT_STATUS / REQUEST_PREV_STATUS in src/lib/mock-data.ts; the labels are REQUEST_NEXT_ACTION / REQUEST_PREV_ACTION. Guards in [brackets] name the predicate in src/lib/permissions.ts." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#6b7280" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="860" height="48" as="geometry" />
        </mxCell>
        <mxCell id="req_q0" value="" style="ellipse;html=1;fillColor=#1f2430;strokeColor=none" vertex="1" parent="1">
          <mxGeometry x="60" y="285" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="req_qReq" value="requested" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#eef2fd;strokeColor=#4169e1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="140" y="275" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="req_qApp" value="approved" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#ffffff;strokeColor=#4169e1;fontSize=13;fontColor=#1f2430" vertex="1" parent="1">
          <mxGeometry x="380" y="275" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="req_qProg" value="in-progress" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#ffffff;strokeColor=#4169e1;fontSize=13;fontColor=#1f2430" vertex="1" parent="1">
          <mxGeometry x="620" y="275" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="req_qRes" value="resolved" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#ffffff;strokeColor=#4169e1;fontSize=13;fontColor=#1f2430" vertex="1" parent="1">
          <mxGeometry x="860" y="275" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="req_qDone" value="completed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#eef2fd;strokeColor=#4169e1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1100" y="275" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="req_q1" value="" style="ellipse;html=1;shape=endState;fillColor=#1f2430;strokeColor=#1f2430" vertex="1" parent="1">
          <mxGeometry x="1310" y="285" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="req_qWith" value="withdrawn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#fdeeee;strokeColor=#c0392b;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="140" y="500" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="req_q2" value="" style="ellipse;html=1;shape=endState;fillColor=#1f2430;strokeColor=#1f2430" vertex="1" parent="1">
          <mxGeometry x="360" y="510" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="req_nDecline" value="&lt;b&gt;Decline is not a transition.&lt;/b&gt;&lt;br&gt;declineRequest attaches a reason and the status &lt;i&gt;holds&lt;/i&gt; at requested, so its submitter can read what was wrong and raise a corrected one. Approving clears the note." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8e6;strokeColor=#b8860b;align=left;verticalAlign=top;spacing=8;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="100" y="120" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="req_nVerify" value="&lt;b&gt;Verification is a flag, not a state.&lt;/b&gt;&lt;br&gt;canRequestVerification: the submitter only, at resolved only, once. It &lt;i&gt;asks&lt;/i&gt; for close-out — an approver still presses it. Requests with no Office Staff behind them never carry it." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8e6;strokeColor=#b8860b;align=left;verticalAlign=top;spacing=8;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="800" y="120" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="req_nWith" value="canWithdrawRequest: the submitter only, and only while &lt;b&gt;requested&lt;/b&gt;. After approval it is committed work and cannot be pulled back." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8e6;strokeColor=#b8860b;align=left;verticalAlign=top;spacing=8;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="380" y="610" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="req_legend" value="&lt;b&gt;Guards&lt;/b&gt;&lt;hr size=&#x27;1&#x27;&gt;&lt;b&gt;canAdvanceRequest&lt;/b&gt; — role ≠ Office Staff.&lt;br&gt;Every forward and backward step is this one gate: whoever moves a request along is who decides it belongs there.&lt;br&gt;&lt;br&gt;&lt;b&gt;Office Staff&lt;/b&gt; may raise, withdraw and verify their own. Nothing else.&lt;br&gt;&lt;i&gt;REQUEST_ADVANCE_LOCK_REASON&lt;/i&gt; is the padlock tooltip." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#d8dbe1;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="860" y="430" width="400" height="180" as="geometry" />
        </mxCell>
        <mxCell id="req_e0" value="raise [any role]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4169e1;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1" source="req_q0" target="req_qReq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="req_e1" value="Approve&lt;br&gt;[canAdvanceRequest]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4169e1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0" edge="1" parent="1" source="req_qReq" target="req_qApp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="req_e2" value="Start work&lt;br&gt;[canAdvanceRequest]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4169e1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0" edge="1" parent="1" source="req_qApp" target="req_qProg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="req_e3" value="Mark resolved&lt;br&gt;[canAdvanceRequest]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4169e1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0" edge="1" parent="1" source="req_qProg" target="req_qRes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="req_e4" value="Close out&lt;br&gt;[canAdvanceRequest]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4169e1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0" edge="1" parent="1" source="req_qRes" target="req_qDone">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="req_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4169e1;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1" source="req_qDone" target="req_q1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="req_e6" value="Withdraw approval" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b7280;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=top;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0" edge="1" parent="1" source="req_qApp" target="req_qReq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="req_e7" value="Back to approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b7280;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=top;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0" edge="1" parent="1" source="req_qProg" target="req_qApp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="req_e8" value="Reopen work" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b7280;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=top;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0" edge="1" parent="1" source="req_qRes" target="req_qProg">
