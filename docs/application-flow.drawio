        <mxCell id="sess_pwd" value="&lt;b&gt;Password routes&lt;/b&gt;&lt;hr size=&#x27;1&#x27;&gt;/login/forgot-password → sends a reset email&lt;br&gt;/login/first-sign-in → the link&#x27;s landing page, reads &lt;i&gt;oobCode&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#d8dbe1;fontSize=12" vertex="1" parent="1">
